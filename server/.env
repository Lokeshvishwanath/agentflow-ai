PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB (leave blank to use in-memory fallback)
MONGODB_URI=mongodb://localhost:27017/agentflow

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis (leave blank to use in-memory fallback)
REDIS_URL=redis://localhost:6379

# AI Providers (set at least one)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Credential encryption (32-char hex key)
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# OAuth - Gmail / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/gmail/callback

# OAuth - Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/slack/callback

# OAuth - Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:5000/api/integrations/oauth/discord/callback
